
import re
import time

# Normalize phone number
def normalize_number(number):
    digits = re.sub(r'\D', '', number)

    if len(digits) == 12 and digits.startswith("91"):
        digits = digits[2:]

    return digits


# Normalize name
def normalize_name(name):
    return " ".join(name.lower().split())


# Merge contacts
def merge_contacts(contacts):
    number_map = {}
    groups = []

    for contact in contacts:
        name = contact.get("name", "").strip()
        numbers = contact.get("numbers", [])
        emails = contact.get("emails", [])

        clean_numbers = {
            normalize_number(n) for n in numbers
            if normalize_number(n)
        }

        clean_emails = {
            e.strip().lower() for e in emails if e.strip()
        }

        if not clean_numbers:
            groups.append({
                "names": {name} if name else set(),
                "numbers": set(),
                "emails": clean_emails
            })
            continue

        matched = {
            id(number_map[n]): number_map[n]
            for n in clean_numbers if n in number_map
        }

        if matched:
            group = next(iter(matched.values()))

            for other in matched.values():
                if other is not group:
                    group["names"].update(other["names"])
                    group["numbers"].update(other["numbers"])
                    group["emails"].update(other["emails"])
                    groups.remove(other)
        else:
            group = {
                "names": set(),
                "numbers": set(),
                "emails": set()
            }
            groups.append(group)

        if name:
            group["names"].add(name)

        group["numbers"].update(clean_numbers)
        group["emails"].update(clean_emails)

        for number in group["numbers"]:
            number_map[number] = group

    return groups


# Sample contacts
contacts = [
