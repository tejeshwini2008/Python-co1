
import csv
import os
from collections import defaultdict

# Five department files
files = [
    "cse.txt",
    "ece.txt",
    "eee.txt",
    "mech.txt",
    "civil.txt"
]

master = []
seen = set()
event_list = defaultdict(list)
errors = []

# Read department files
for filename in files:
    try:
        with open(filename, "r") as file:
            for line_no, line in enumerate(file, 1):
                try:
                    row = next(csv.reader([line], strict=True))

                    if len(row) != 5:
                        raise ValueError("Damaged line")

                    reg, name, dept, email, events = [
                        x.strip() for x in row
                    ]

                    # Validate fields
                    if not reg or not name or not dept:
                        raise ValueError("Missing field")

                    # Validate email
                    if ("@" not in email or
                        email.count("@") != 1 or
                        " " in email or
                        "." not in email.split("@")[1]):
                        raise ValueError("Invalid email")

                    # Remove duplicate registration
                    if reg in seen:
                        errors.append(
                            f"{filename} Line {line_no}: Duplicate {reg}"
                        )
                        continue

                    seen.add(reg)

                    event_names = [
                        e.strip() for e in events.split(";")
                        if e.strip()
                    ]

                    contact = {
                        "reg": reg,
                        "name": name,
                        "dept": dept,
                        "email": email,
                        "events": event_names
                    }

                    master.append(contact)

                    for event in event_names:
                        event_list[event].append(name)

                except (ValueError, csv.Error) as e:
                    errors.append(
                        f"{filename} Line {line_no}: {e}"
                    )

    except FileNotFoundError:
        errors.append(f"{filename}: File not found")

    except OSError as e:
        errors.append(f"{filename}: {e}")


# Write master list
with open("master_list.txt", "w") as f:
    for c in master:
        f.write(
            f'{c["reg"]}, {c["name"]}, {c["dept"]}, '
            f'{c["email"]}, {";".join(c["events"])}\n'
        )


# Write event-wise list
with open("event_wise.txt", "w") as f:
    for event, names in sorted(event_list.items()):
        f.write(event + ": " + ", ".join(names) + "\n")


# Write summary report
with open("summary_report.txt", "w") as f:
    f.write("COLLEGE FEST SUMMARY\n")
    f.write(f"Total valid registrations: {len(master)}\n")
    f.write(f"Total events: {len(event_list)}\n")
    f.write(f"Total errors: {len(errors)}\n")


# Write error log
with open("error_log.txt", "w") as f:
    for error in errors:
        f.write(error + "\n")


# Display results
print("COLLEGE FEST REGISTRATION REPORT")
print("Valid Registrations:", len(master))
print("Total Events:", len(event_list))
print("Total Errors:", len(errors))

print("\nMaster List Created")
print("Event-wise List Created")
print("Summary Report Created")
print("Error Log Created")

print("\nAll files processed successfully!")

