
import re
import sqlite3
import time
from collections import Counter

# Sentiment words
POSITIVE = {"good", "clean", "fast", "helpful", "improved"}
NEGATIVE = {"bad", "dirty", "slow", "rude", "smoke"}
NEGATORS = {"not", "never", "no"}

# Sentiment scoring
def score(text):
    words = re.findall(r"[a-z]+", text.lower())
    total = 0

    for i, word in enumerate(words):
        value = 1 if word in POSITIVE else -1 if word in NEGATIVE else 0

        if i > 0 and words[i-1] in NEGATORS:
            value = -value

        total += value

    return total


# Sentiment label
def label(text):
    s = score(text)

    if s > 0:
        return "positive"
    elif s < 0:
        return "negative"
    else:
        return "neutral"


# Complaint summariser
def summarise(texts):
    stopwords = {
        "the", "is", "are", "was", "and", "a",
        "to", "from", "in", "of", "it", "this"
    }

    words = []

    for text in texts:
        words += re.findall(r"[a-z]+", text.lower())

    important = [
        word for word in words
        if word not in stopwords
    ]

    return Counter(important).most_common(5)


# Sample complaints
base = [
    "Roads are clean and the bus was fast.",
    "Smoke from the factory air is bad.",
    "The staff were not helpful.",
    "Not bad, service improved.",
    "The road is dirty and slow.",
    "The staff are helpful and good.",
    "Factory smoke is bad.",
    "Bus service is fast and clean.",
    "The service is rude.",
    "The road is clean and improved."
]

# Create 50 complaints
complaints = []

for i in range(50):
    complaints.append({
        "station": "Station" + str(i % 5 + 1),
        "day": "Day" + str(i % 7 + 1),
        "text": base[i % 10]
    })


# Display sentiment results
print("SENTIMENT ANALYSIS")

for c in complaints[:4]:
    print(label(c["text"]), "|", c["text"])


# Manual labels for the 50 complaints
human_labels = [
    label(base[i % 10]) for i in range(50)
]

predicted_labels = [
    label(c["text"]) for c in complaints
]

agree = sum(
    a == b for a, b in zip(human_labels, predicted_labels)
)

print("\nAgreement:", agree, "/ 50")
print("Agreement Percentage:", agree / 50 * 100)


# Summarisation
print("\nTOP IMPORTANT WORDS")
print(summarise([c["text"] for c in complaints]))


# Database creation
db = sqlite3.connect(":memory:")
cur = db.cursor()

cur.execute("""
CREATE TABLE complaints (
    station TEXT,
    day TEXT,
    complaint TEXT,
    sentiment TEXT
)
""")

# Insert 50,000 complaints for performance testing
data = []

for i in range(50000):
    c = complaints[i % 50]
    data.append((
        c["station"],
        c["day"],
        c["text"],
        label(c["text"])
    ))

cur.executemany(
    "INSERT INTO complaints VALUES (?, ?, ?, ?)",
    data
)

db.commit()


# Query before indexing
query = """
SELECT COUNT(*) FROM complaints
WHERE station = ? AND day = ?
"""

start = time.perf_counter()

for i in range(100):
    cur.execute(query, ("Station1", "Day1"))
    cur.fetchone()

before = time.perf_counter() - start


# Create index
cur.execute("""
CREATE INDEX idx_station_day
ON complaints(station, day)
""")

db.commit()


# Query after indexing
start = time.perf_counter()

for i in range(100):
    cur.execute(query, ("Station1", "Day1"))
    cur.fetchone()

after = time.perf_counter() - start


print("\nDATABASE PERFORMANCE")
print("Complaints:", 50000)
print("Time Before Index:", before)
print("Time After Index:", after)

if before > 0:
    print("Speed Improvement:",
          round(before / after, 2), "times")

db.close()


# Production decision
print("\nPRODUCTION DECISION")
print("Use database storage with station-day index.")
print("Clean and validate complaints before analysis.")
print("Use AI models for complex sentiment analysis.")

