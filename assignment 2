
import time

# Original Method - Nested Loops
def original(arr):
    duplicates = []
    count = 0

    for i in range(len(arr)):
        for j in range(i + 1, len(arr)):
            count += 1
            if arr[i] == arr[j] and arr[i] not in duplicates:
                duplicates.append(arr[i])

    return sorted(duplicates), count


# Redesigned Method - Using Set
def redesigned(arr):
    seen = set()
    duplicates = set()
    count = 0

    for num in arr:
        count += 1

        if num in seen:
            duplicates.add(num)
        else:
            seen.add(num)

    return sorted(duplicates), count


# Main Program
n = int(input("Enter number of elements: "))
arr = []

for i in range(n):
    arr.append(int(input()))

# Original Execution
start = time.perf_counter()
old_result, old_count = original(arr)
old_time = time.perf_counter() - start

# Redesigned Execution
start = time.perf_counter()
new_result, new_count = redesigned(arr)
new_time = time.perf_counter() - start

# Display Results
print("\nOriginal Result:", old_result)
print("Original Comparisons:", old_count)
print("Original Time:", old_time)

print("\nRedesigned Result:", new_result)
print("Redesigned Operations:", new_count)
print("Redesigned Time:", new_time)

print("\nBoth Results are Same:", old_result == new_result)

